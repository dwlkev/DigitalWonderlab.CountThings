<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<!-- NuGet metadata -->
		<IsPackable>true</IsPackable>
		<PackageId>DigitalWonderlab.CountThings</PackageId>
		<Version>1.5.0</Version>
		<!-- Bump for reinstall -->
		<Authors>Digital Wonderlab</Authors>
		<Company>Digital Wonderlab</Company>
		<Description>Count Things dashboard for Umbraco 13 - 17.</Description>
		<PackageReleaseNotes>1.5.0 - SECURITY: the Count Things API now requires a signed-in backoffice user (up to 1.4.4 anyone could read a site's counts). Adds an anonymous daily telemetry heartbeat (random install ID, versions, size bands; on by default, off in the dashboard Settings tab or with CountThings:Telemetry:Enabled = false). See the README.</PackageReleaseNotes>
		<PackageTags>umbraco;umbraco-cms;dashboard;umbraco-marketplace</PackageTags>
		<RepositoryUrl>https://github.com/dwlkev/DigitalWonderlab.CountThings</RepositoryUrl>
		<PackageProjectUrl>https://github.com/dwlkev/DigitalWonderlab.CountThings</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>

		<!-- Key for Umbraco App_Plugins packing -->
		<ContentTargetFolders>content</ContentTargetFolders>
		<!-- Release assemblies otherwise carry a debug-directory entry holding the absolute .pdb path from the
		     build machine (username + folder layout) inside the published .dll. We publish no symbols, so drop
		     them on Release (fixed in 1.5.0; same fix as the Community suite 1.3.2). -->
		<DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
		<DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
		<EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
		<IncludeBuildOutput>true</IncludeBuildOutput>

	</PropertyGroup>

	<!-- Dependencies (keep your existing) -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Umbraco.Cms.Core" Version="[13.0.0,15.0.0)" />
		<PackageReference Include="Umbraco.Cms.Web.Common" Version="[13.0.0,15.0.0)"  />
		<PackageReference Include="Umbraco.Cms.Infrastructure" Version="[13.0.0,15.0.0)"  />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Umbraco.Cms.Core" Version="[15.0.0,17.0.0)"  />
		<PackageReference Include="Umbraco.Cms.Web.Common" Version="[15.0.0,17.0.0)"  />
		<PackageReference Include="Umbraco.Cms.Infrastructure" Version="[15.0.0,17.0.0)"  />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Umbraco.Cms.Core" Version="[17.0.0,18.0.0)" />
		<PackageReference Include="Umbraco.Cms.Web.Common" Version="[17.0.0,18.0.0)" />
		<PackageReference Include="Umbraco.Cms.Infrastructure" Version="[17.0.0,18.0.0)" />
	</ItemGroup>


	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<!-- Pack App_Plugins as content -->
	<ItemGroup>
		<Content Include="App_Plugins\CountThings\**" ExcludeFromSingleFile="true">
			<Pack>true</Pack>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

		<!-- Pack .targets to buildTransitive (Umbraco standard for copy on build) -->
		<None Include="buildTransitive\**" Pack="true" PackagePath="buildTransitive" />
	</ItemGroup>

	<!-- README + icon -->
	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>